# Copy to .env and fill in. Never commit .env. See docs/SETUP.md for where each key comes from.
# Older AI_AUDIO_* names are still read as a fallback for every EMVOOX_* setting.

# ---- Vendor keys (set the ones you use) ----
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# WaveSpeed.ai: one key for the LLM gateway (llm.wavespeed.ai, OpenAI-compatible) and the speech models
WAVESPEED_API_KEY=
# Optional
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- LLM (agents' reasoning: research, story, outline, drafts, direction, QA metadata) ----
# gemini | wavespeed | openai | anthropic | mock
EMVOOX_LLM_PROVIDER=gemini
# gemini: gemini-3.1-flash-lite   wavespeed: vendor/model; empty = google/gemini-3.1-flash-lite (other verified ids: docs/SETUP.md §3)
EMVOOX_LLM_MODEL=
EMVOOX_LLM_TEMPERATURE=0.4

# ---- TTS (default engine; a run can override it, Voice IPs with a cloned voice use their own engine) ----
# gemini | elevenlabs | wavespeed | mock
EMVOOX_TTS_PROVIDER=gemini
# empty = the engine's default. wavespeed: elevenlabs/eleven-v3 (default) | minimax/speech-2.6-hd | google/gemini-3.8-flash/text-to-speech | google/gemini-3.8-flash-lite/text-to-speech
EMVOOX_TTS_MODEL=
EMVOOX_TTS_BATCHING=auto
EMVOOX_PREFER_CLONED_VOICES=true
EMVOOX_NORMALIZE_VI=true

# ---- Storage (local-first until V1RON OS) ----
EMVOOX_STORAGE=local
EMVOOX_DATA_DIR=./data
# json (one file per document) | sqlite (documents in data/emvoox.sqlite3)
EMVOOX_DOC_STORE=json

# ---- Assembly (D5, D6, D8, D9) ----
ENABLE_BGM=false
ENABLE_SFX=false
EMVOOX_BGM_GAIN_DB=-20
EMVOOX_PADDING_MS=400
EMVOOX_PADDING_MIN_MS=300
EMVOOX_PADDING_MAX_MS=500
EMVOOX_USE_DIRECTOR_PAUSES=true
EMVOOX_SCENE_GAP_MS=800
EMVOOX_LOUDNESS_LUFS=-16
EMVOOX_TRUE_PEAK_DBTP=-1.5
EMVOOX_MP3_BITRATE=192k

# ---- QA loop and human gate ----
EMVOOX_QA_MAX_RETRIES=3
EMVOOX_QA_PASS_SCORE=80
# transcript check of every stem with the LLM's audio input (Gemini); costs tokens
EMVOOX_QA_TRANSCRIBE=false
EMVOOX_CLIFFHANGER_CHECK=true
EMVOOX_CLIFFHANGER_MIN_SCORE=6
EMVOOX_AUTO_APPROVE=false
EMVOOX_HALT_ON_QA_FAIL=true

# ---- Market research ----
# headless browser scan of public platform pages (pip install -e '.[research]' && playwright install chromium)
EMVOOX_RESEARCH_USE_BROWSER=false

# ---- Web ----
EMVOOX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# show the offline mock engines in the UI (tests and demos)
EMVOOX_ENABLE_MOCK=false
