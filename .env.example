# Copy to .env and fill in. Never commit .env. See docs/SETUP.md for where each key comes from.

# ---- Phase 1 (episodize + AI Director) ----
GEMINI_API_KEY=

# ---- Phase 2 (TTS) ----
# Two engines: ElevenLabs (paid; your Voice IPs) and Gemini TTS (free tier; uses GEMINI_API_KEY above).
ELEVENLABS_API_KEY=

# ---- LLM (D10) ----
AI_AUDIO_LLM_MODEL=gemini-3.1-flash-lite   # gemini-2.5-flash is closed to new accounts; gemini-3.6-flash = thinking alternative
AI_AUDIO_LLM_TEMPERATURE=0.4

# ---- TTS (D4) ----
# default engine for new runs; the web client can pick per run (elevenlabs | gemini)
AI_AUDIO_TTS_PROVIDER=elevenlabs
# leave empty for the provider default (eleven_v3 / gemini-2.5-flash-preview-tts)
AI_AUDIO_TTS_MODEL=
AI_AUDIO_NORMALIZE_VI=true

# ---- Assembly (D5, D6, D8, D9) ----
ENABLE_BGM=false
ENABLE_SFX=false
AI_AUDIO_PADDING_MS=400
AI_AUDIO_PADDING_MIN_MS=300
AI_AUDIO_PADDING_MAX_MS=500
AI_AUDIO_USE_DIRECTOR_PAUSES=true
AI_AUDIO_SCENE_GAP_MS=800
AI_AUDIO_LOUDNESS_LUFS=-16
AI_AUDIO_TRUE_PEAK_DBTP=-1.5
AI_AUDIO_MP3_BITRATE=192k
